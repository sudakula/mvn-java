{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "title": "ICN Progress PoC with Status and Timestamps",
  "width": 1000,
  "height": 250,

  "data": [
    {
      "name": "blocks",
      "values": [
        {"block": "block 1", "x": 40, "status": "finished", "timestamp": "2025-10-05 10:15"},
        {"block": "block 2", "x": 140, "status": "finished", "timestamp": "2025-10-05 10:30"},
        {"block": "block 3", "x": 240, "status": "in-progress", "timestamp": "2025-10-05 11:00"},
        {"block": "block 4", "x": 340, "status": "pending"},
        {"block": "block 5", "x": 440, "status": "pending"},
        {"block": "block 6", "x": 540, "status": "pending"},
        {"block": "block 7", "x": 640, "status": "pending"},
        {"block": "block 8", "x": 740, "status": "pending"},
        {"block": "block 9", "x": 840, "status": "pending"},
        {"block": "block 10", "x": 940, "status": "pending"}
      ]
    }
  ],

  "marks": [
    {
      "type": "rect",
      "from": {"data": "blocks"},
      "encode": {
        "enter": {
          "x": {"field": "x"},
          "y": {"value": 60},
          "width": {"value": 80},
          "height": {"value": 60},
          "stroke": {"value": "black"},
          "strokeWidth": {"value": 1}
        },
        "update": {
          "fill": [
            {"test": "datum.status === 'finished'", "value": "#00c853"},
            {"test": "datum.status === 'in-progress'", "value": "#ffeb3b"},
            {"value": "#bdbdbd"}
          ]
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "blocks"},
      "encode": {
        "enter": {
          "x": {"signal": "datum.x + 40"},
          "y": {"value": 90},
          "align": {"value": "center"},
          "baseline": {"value": "middle"},
          "text": {"field": "block"},
          "fontSize": {"value": 12},
          "fill": {"value": "black"}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "blocks"},
      "encode": {
        "enter": {
          "x": {"signal": "datum.x + 40"},
          "y": {"value": 130},
          "align": {"value": "center"},
          "baseline": {"value": "top"},
          "text": {"signal": "datum.timestamp || ''"},
          "fontSize": {"value": 10},
          "fill": {"value": "#2e7d32"}
        }
      }
    }
  ]
}
