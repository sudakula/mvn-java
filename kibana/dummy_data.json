{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "title": "ICN Progress PoC - Dynamic Width",
  "width": 600,
  "height": 600,

  "data": [
    {
      "name": "blocks",
      "values": [
        {"block": "block 1 - validation complete", "y": 40, "status": "finished", "timestamp": "2025-10-05 10:15"},
        {"block": "block 2 - validation started", "y": 140, "status": "finished", "timestamp": "2025-10-05 10:30"},
        {"block": "block 3 - in progress", "y": 240, "status": "in-progress", "timestamp": "2025-10-05 11:00"},
        {"block": "block 4", "y": 340, "status": "pending"},
        {"block": "block 5", "y": 440, "status": "pending"}
      ]
    }
  ],

  "signals": [
    {
      "name": "padding",
      "value": 20
    }
  ],

  "marks": [
    // Hidden text to measure width
    {
      "type": "text",
      "from": {"data": "blocks"},
      "encode": {
        "enter": {
          "text": {"field": "block"},
          "fontSize": {"value": 12}
        },
        "update": {
          "x": {"value": 0},
          "y": {"value": 0},
          "opacity": {"value": 0}
        }
      },
      "transform": [
        {"type": "formula", "as": "textWidth", "expr": "width(datum)"}
      ]
    },

    // Rectangles with dynamic width
    {
      "type": "rect",
      "from": {"data": "blocks"},
      "encode": {
        "enter": {
          "x": {"value": 60},
          "y": {"field": "y"},
          "height": {"value": 50},
          "stroke": {"value": "black"},
          "strokeWidth": {"value": 1}
        },
        "update": {
          "fill": [
            {"test": "datum.status === 'finished'", "value": "#00c853"},
            {"test": "datum.status === 'in-progress'", "value": "#ffeb3b"},
            {"value": "#bdbdbd"}
          ],
          "width": {"signal": "datum.block.length * 8 + padding"}
        }
      }
    },

    // Block labels
    {
      "type": "text",
      "from": {"data": "blocks"},
      "encode": {
        "enter": {
          "x": {"signal": "60 + 5"},
          "y": {"signal": "datum.y + 25"},
          "align": {"value": "left"},
          "baseline": {"value": "middle"},
          "text": {"field": "block"},
          "fontSize": {"value": 12},
          "fill": {"value": "black"}
        }
      }
    },

    // Timestamps
    {
      "type": "text",
      "from": {"data": "blocks"},
      "encode": {
        "enter": {
          "x": {"signal": "60 + 5"},
          "y": {"signal": "datum.y + 55"},
          "align": {"value": "left"},
          "baseline": {"value": "top"},
          "text": {"signal": "datum.timestamp || ''"},
          "fontSize": {"value": 10},
          "fill": {"value": "#2e7d32"}
        }
      }
    }
  ]
}
